# Set these in Vercel: Project → Settings → Environment Variables, then redeploy.

# Required. The ntfy topic to publish to. Anyone who knows the name can read it,
# so make it long and unguessable, and never commit the real value.
NTFY_TOPIC=

# Optional. Defaults to https://ntfy.sh. Set it if you self-host ntfy.
NTFY_SERVER=

# Optional. Access token, if the topic is protected.
NTFY_TOKEN=
